{
  "name": "pangenome-range-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check": "biome check . && pnpm check:versions && pnpm typecheck && pnpm test",
    "check:versions": "node npm/scripts/verify-version-sync.mjs",
    "check:rust": "bash scripts/check-rust.sh",
    "build": "pnpm --filter pangenome-range build && pnpm --filter pangenome-range test:bundle && pnpm --filter @pangenome-range/benchmark build && pnpm --filter @pangenome-range/docs build && pnpm smoke:exports",
    "smoke:exports": "node packages/browser/test/export-smoke.mjs",
    "docs:dev": "pnpm --filter @pangenome-range/docs dev",
    "docs:fixtures": "pnpm --filter @pangenome-range/docs fixtures",
    "docs:build": "pnpm --filter pangenome-range build && pnpm --filter @pangenome-range/docs build",
    "test:pages": "pnpm --filter pangenome-range build && pnpm --filter @pangenome-range/docs build && pnpm --filter @pangenome-range/docs test:pages",
    "test:browser": "pnpm --filter @pangenome-range/benchmark test:browser",
    "test:browser:ci": "pnpm --filter @pangenome-range/benchmark test:browser:ci",
    "bench": "pnpm --filter pangenome-range build && pnpm --filter @pangenome-range/benchmark build && pnpm --filter @pangenome-range/benchmark bench",
    "package:cargo": "node npm/scripts/verify-cargo-package.mjs",
    "package:cargo:list": "cargo package -p pangenome-range-cli --allow-dirty --locked --list",
    "release:stage": "node npm/scripts/stage-release-set.mjs",
    "release:verify": "node npm/scripts/verify-release-set.mjs",
    "release:pack": "node npm/scripts/pack-release-set.mjs",
    "release:smoke": "node npm/scripts/smoke-packed-release.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "typescript": "^6.0.3"
  }
}
